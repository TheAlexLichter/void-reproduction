{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "void/env"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["pages", "tests", "scripts", "vite.config.ts", "void.config.ts"]
}
